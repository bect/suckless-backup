#!/usr/bin/env bash

# Clean, minimalist Desktop Power Hub powered by centered Dmenu
# Designed for total desktop synergy with the luxury cafe theme

# Define choices using universally-compatible Nerd Font icons
options="  Shutdown\n  Reboot\n  Suspend\n  Logout\n  Emojis"

# Display choices via Dmenu with an elegant custom prompt
chosen=$(printf "$options" | dmenu -p "Desktop Hub:")

# Map selections to system tasks or spawn the curated emoji picker
case "$chosen" in
    "  Shutdown")
        systemctl poweroff
        ;;
    "  Reboot")
        systemctl reboot
        ;;
    "  Suspend")
        systemctl suspend
        ;;
    "  Logout")
        killall dwm
        ;;
    "  Emojis")
        # Standard UNIX Path for installed system data
        EMOJI_FILE="/usr/local/share/dm-power/emojis.txt"
        
        # Elegant Fallback: If not installed, search in current script directory (Dev mode)
        if [ ! -f "$EMOJI_FILE" ]; then
            EMOJI_FILE="$(dirname "$(readlink -f "$0")")/emojis.txt"
        fi
        
        # Verify file exists before proceeding
        if [ ! -f "$EMOJI_FILE" ]; then
            notify-send "Emoji Error" "Missing emoji database: emojis.txt" -i dialog-error
            exit 1
        fi
        
        # Instant dynamic load into memory (Exact equivalent of C's include/cat)
        emojis=$(< "$EMOJI_FILE")
        
        # Feed curated list into centered dmenu
        chosen_emoji=$(printf "$emojis" | dmenu -i -p "Pick Emoji:")
        
        # If selection was made, parse and push to clipboard
        if [ -n "$chosen_emoji" ]; then
            emoji=$(echo "$chosen_emoji" | awk '{print $1}')
            
            if command -v xclip >/dev/null; then
                echo -n "$emoji" | xclip -selection clipboard
                notify-send "Clipboard Copy" "Copied '$emoji' to your clipboard!" -i face-smile
            else
                notify-send "Error" "Please install xclip to copy emojis!" -i dialog-error
            fi
        fi
        ;;
    *)
        exit 0
        ;;
esac
