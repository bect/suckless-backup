#!/usr/bin/env bash

# Specialized standalone Desktop Power utility powered by Dmenu
# Focuses strictly and efficiently on system state controls

# Choices using universally-compatible Nerd Font icons
options="  Shutdown\n  Reboot\n  Suspend\n  Logout"

# Prompt user via centered Dmenu
chosen=$(printf "$options" | dmenu -p "System Power:")

# Execute physical state tasks directly
case "$chosen" in
    "  Shutdown")
        systemctl poweroff
        ;;
    "  Reboot")
        systemctl reboot
        ;;
    "  Suspend")
        systemctl suspend
        ;;
    "  Logout")
        killall dwm
        ;;
    *)
        exit 0
        ;;
esac
